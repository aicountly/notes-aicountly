# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
build/
*.local

# Environment files — NEVER commit real credentials or endpoints.
# .env.example is the tracked template; everything else stays local.
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.suo
*.ntvs*
*.njsproj
*.sln

# OS
.DS_Store
Thumbs.db

# Tooling caches
.eslintcache
*.tsbuildinfo
.cache/

# Attachment bytes written by the local object store. These exist only on the
# machine that wrote them and must never reach the repository — the deploy also
# excludes storage/ from --delete so a release cannot erase them on the server.
server-php/storage/

# Playwright output
test-results/
playwright-report/
blob-report/
.playwright/
