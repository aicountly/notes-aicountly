# ---------------------------------------------------------------------------
# Notes API — server environment template
#
# Unlike the React build, this file is read at RUNTIME on every request. It
# belongs on the server and only on the server:
#
#   1. Copy this file to <document root>/api/.env by hand, once (cPanel File
#      Manager or SSH).
#   2. It is git-ignored, and every rsync step passes --exclude='.env', so a
#      --delete deploy leaves it untouched.
#
# See docs/DEPLOYMENT.md.
# ---------------------------------------------------------------------------

# Which deployment this is: production | sandbox | local
# Reported by GET /api/health, so you can tell the two environments apart.
APP_ENV=production

# Verbose errors and info-level logging. NEVER true in production: it puts
# exception messages and file paths into API responses.
# APP_DEBUG=false


# --- Database (required) ---------------------------------------------------
#
# PostgreSQL. Not "a database": notes are stored as jsonb, search runs on a
# generated tsvector with a GIN index, and semantic search expects pgvector.
# See docs/DATABASE.md.
#
# On cPanel both the database and the user are prefixed with the account name,
# so a database created as `notes` becomes `<cpaneluser>_notes`. Use the full
# prefixed names, grant the user ALL PRIVILEGES on the database, and leave
# DB_HOST as localhost — on cPanel the database is on the same machine.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# DB_SCHEMA=public
# DB_SSLMODE=require

# After a deploy that adds a migration, run this once over SSH:
#   cd <document root>/api && php bin/migrate.php up && php bin/migrate.php seed


# --- AICOUNTLY portal ------------------------------------------------------
# Auth API. Leave unset unless you are pointing at a non-standard portal —
# my.aicountly.com serves BOTH production and sandbox. (sandbox.aicountly.com
# is a login redirect only; it does not serve seskey or validatesession.)
# PORTAL_AUTH_BASE=https://my.aicountly.com

# How long a validated ses_key is cached before the portal is asked again.
# Validating on every request would put the portal in the critical path of
# every autosave; caching for longer than this delays a revocation taking
# effect. 0 disables the cache. Maximum 300.
# NOTES_SESSION_CACHE_SECONDS=60

# Comma-separated origins allowed to call this API cross-origin.
# Both deployed environments are same-origin with their app, so leave this
# empty in production. It exists for `npm run dev` against a deployed API.
# CORS_ALLOWED_ORIGINS=http://localhost:5173


# --- Storage ---------------------------------------------------------------
# Where attachment bytes go when AICOUNTLY Drive is not configured. Must NOT be
# reachable over HTTP — the API writes a deny-all .htaccess into it, but a path
# outside the document root is better.
# NOTES_STORAGE_PATH=/home/<cpaneluser>/notes-storage

# Largest attachment accepted, in bytes. Default 25 MB. PHP's own
# upload_max_filesize and post_max_size still apply and are usually lower.
# NOTES_MAX_ATTACHMENT_SIZE=26214400

# How long a note stays in Trash before the worker removes it for good.
# NOTES_TRASH_RETENTION_DAYS=30

# Version-history tuning. Consecutive autosaves by one author inside the
# coalesce window rewrite one checkpoint instead of adding a row each time.
# NOTES_REVISION_COALESCE_MINUTES=10
# NOTES_REVISION_KEEP=100


# --- Feature flags ---------------------------------------------------------
#
# Every one of these defaults to FALSE, and a flag that is off makes its
# endpoints answer 503 FEATURE_DISABLED. The frontend reads the same flags from
# GET /api/config and hides the controls, so an unconfigured deployment looks
# like a smaller product rather than a broken one.
#
# A flag also stays off when what it depends on is missing: turning on
# NOTES_AI_ENABLED without PULSE_API_URL would only produce Pulse buttons that
# fail on click.

# Pulse: selection actions, Ask this note, Ask notebook, Ask my notes.
#
# This one DOES need a URL, and cannot be derived. Pulse exposes a session-and-
# message chat API, not a prompt-completion endpoint, so there is no route to
# infer — see docs/PULSE_INTEGRATION.md. Until that is settled, leaving this
# unset is correct and the UI says Pulse is unavailable rather than offering
# controls that fail.
# NOTES_AI_ENABLED=false
# PULSE_API_URL=
# PULSE_API_KEY=
# PULSE_MODEL=

# Semantic search. Needs PULSE_API_URL for embeddings, and works best with
# pgvector — migration 0008 installs it where the host allows, and is recorded
# as skipped where it does not (see `php bin/migrate.php status`).
# NOTES_SEMANTIC_SEARCH_ENABLED=false

# OCR and transcription. There is no local engine: these post to a configured
# service. With the flag off, those processing jobs are marked skipped rather
# than failed, and nothing is retried.
# NOTES_OCR_ENABLED=false
# NOTES_OCR_URL=
# NOTES_TRANSCRIPTION_ENABLED=false
# Needs an endpoint that a BACKGROUND WORKER can authenticate to. Pulse's
# /api/speech/transcribe cannot be used: it requires a live ses_key, and by the
# time a transcription job runs the user's key is long gone. See
# docs/PULSE_INTEGRATION.md. Until such an endpoint exists, leaving this unset
# is correct — the job is marked skipped, not failed, and is not retried.
# NOTES_TRANSCRIPTION_API_URL=
# NOTES_TRANSCRIPTION_API_TOKEN=

# Real-time collaborative editing. Not implemented — the document format and
# the service boundaries are prepared for Yjs, but there is no realtime server.
# Leave this off. See docs/ARCHITECTURE.md.
# NOTES_REALTIME_ENABLED=false

# Infinite canvas notes. The note type and storage exist; the canvas editor
# does not. Leave off. See docs/ARCHITECTURE.md.
# NOTES_CANVAS_ENABLED=false

# End-to-end encrypted private notes. Turn this on ONLY when client-side key
# management is deployed: with it on, a note may be marked `private`, and this
# server must then never be able to read it. See docs/SECURITY.md.
# NOTES_PRIVATE_NOTES_ENABLED=false


# --- AICOUNTLY product integrations ----------------------------------------
#
# Each is an adapter with an honest disabled state, and each needs only its
# flag. The sibling's address is derived from THIS deployment's hostname the
# same way every other AICOUNTLY product does it: notes.gh.aicountly.com talks
# to drive.gh.aicountly.com, notes.aicountly.com talks to drive.aicountly.com.
#
# So there is nothing to set per environment, and no way to point production at
# sandbox by copying the wrong .env. An unrecognised hostname resolves to
# sandbox rather than production — reading live company data by accident is the
# worse failure.
#
# The flags are all there is to set:
# NOTES_DRIVE_ENABLED=false
# NOTES_CALENDAR_ENABLED=false
# NOTES_CONTACTS_ENABLED=false
# NOTES_CONNECT_ENABLED=false

# Serve a Drive-stored attachment by redirecting the browser to Drive's
# presigned S3 URL, instead of passing the bytes through this server.
#
# Leave it off unless this deployment's origin is on the Drive bucket's CORS
# allowlist. The SPA fetches the download endpoint (it needs a Bearer token),
# and a fetch that follows a redirect to another origin is subject to that
# origin's CORS rules — Drive's production bucket allows drive.aicountly.com
# and nothing else, so the redirect fails with "Failed to fetch" and no status.
# drive-react-app/docs/S3_CORS.md describes how an operator adds an origin;
# once it is there, this saves the file crossing this server at all.
# NOTES_DRIVE_DIRECT_DOWNLOAD=false

# Overrides, for a product that is somewhere unusual. Almost never needed.
#
# *_API_ORIGIN is scheme-and-host only, with NO path: Notes appends `/api`
# itself, exactly as Pulse's ProductApiResolver does. This is the name the rest
# of the suite uses.
#
# Note that a HOST is not a product_code. Drive answers on drive.aicountly.com
# while its product_code — the value that goes in an upload-session body and in
# every object key it has ever written — is `docs`; Connect is connect./`chat`,
# Pulse is pulse./`buddy`. Either spelling works below (DRIVE_API_ORIGIN and
# DOCS_API_ORIGIN name the same thing) because the person editing this file is
# looking at a hostname.
# DRIVE_API_ORIGIN=
# CALENDAR_API_ORIGIN=
# CONTACTS_API_ORIGIN=
# CONNECT_API_ORIGIN=
#
# DEPRECATED, still read so an existing .env keeps working after an upgrade:
# *_API_URL named a full API base INCLUDING the /api path, so it is used
# verbatim rather than having a prefix appended. Set *_API_ORIGIN instead.
# DRIVE_API_URL=
# CALENDAR_API_URL=
# CONTACTS_API_URL=
# CONNECT_API_URL=
#
# PULSE_API_URL is deliberately NOT in that list: in this repository it names
# the model gateway the AI feature posts completions to (above), which is a
# different service from the Pulse product's own API. The Pulse product's
# origin, if it ever needs overriding, is PULSE_API_ORIGIN.


# --- Testing ---------------------------------------------------------------
# The database `php tests/run.php` may TRUNCATE. It must contain "test" in its
# name, and it must never be the live one.
# TEST_DB_NAME=notes_test
